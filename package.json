{
  "name": "n8n-nodes-cashnutra",
  "version": "0.1.0",
  "description": "Read approved Cash Nutra offers and affiliate-scoped conversions in n8n.",
  "license": "MIT",
  "homepage": "https://www.cash-nutra.com/docs/affiliate-api",
  "repository": {
    "type": "git",
    "url": "https://github.com/cashnutra/n8n-nodes-cashnutra.git"
  },
  "author": {
    "name": "Cash Nutra",
    "email": "hello@cash-nutra.com"
  },
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "affiliate-marketing",
    "cash-nutra",
    "nutra"
  ],
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "validate": "n8n-node lint && n8n-node build && node scripts/qa.mjs"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/CashNutraApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/CashNutra/CashNutra.node.js"
    ]
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.46.2",
    "eslint": "^9.29.0",
    "n8n-workflow": "^2.16.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
